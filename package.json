{
  "name": "temp-app",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:dedicated": "PLAYWRIGHT_PORT=3400 CI=true playwright test --project=chromium",
    "test:e2e:fast": "PLAYWRIGHT_PORT=3400 playwright test --project=chromium --workers=1 --retries=0",
    "test:e2e:headed:debug": "PLAYWRIGHT_PORT=3400 playwright test --project=chromium --headed --workers=1 --retries=0",
    "test:ci": "npm run lint && npm run test:unit && CI=true npm run test:e2e",
    "printer:emulator": "node scripts/printer-emulator.mjs",
    "printer:up": "docker compose up -d printer-emulator",
    "printer:down": "docker compose stop printer-emulator",
    "printer:logs": "docker compose logs -f printer-emulator",
    "deploy:bergamo": "./scripts/deploy-bergamo.sh",
    "db:up": "docker compose up -d mongodb",
    "db:down": "docker compose stop mongodb"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@sumup/sdk": "^0.1.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "mongoose": "^9.2.1",
    "nanoid": "^5.1.6",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "node-thermal-printer": "^4.6.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "shadow-cljs": "^3.3.6",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.1.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
