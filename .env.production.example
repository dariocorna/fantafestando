# MongoDB bootstrap credentials (used by mongo container)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-strong-password
MONGO_DATABASE=fantafestando

# App runtime
# NEXTAUTH_URL deve puntare all'origine reale del backoffice:
# - privata/LAN: es. http://192.168.68.64:3101
# - pubblica PoC: es. https://backoffice-fantafestando.ddns.net
MONGODB_URI=mongodb://root:change-me-strong-password@mongo:27017/fantafestando?authSource=admin
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://<lan-host-or-private-dns>:3101
NEXTAUTH_URL_MENU=https://fantafestando.ddns.net
NEXTAUTH_URL_INTERNAL=http://fantafestando-backoffice:3000
APP_VERSION=0.9.1
APP_BUILD=
APP_BUILD_DATE=
APP_RUNTIME_ENV_FILE=.env.production
APP_IMAGE_NAME=fantafestando-app
APP_IMAGE_TAG=latest
APP_RUNTIME_UID=1000
APP_RUNTIME_GID=1000
BACKOFFICE_BIND_HOST=127.0.0.1
BACKOFFICE_BIND_PORT=3101
MENU_BIND_PORT=3102

# Optional runtime backup UI
# BACKUP_TARGETS_HOST_ROOT deve puntare alla root host che contiene i mount USB o le directory di destinazione.
# Esempi comuni: /media, /mnt, /srv/backups
BACKUP_TARGETS_HOST_ROOT=/media
BACKUP_SCHEDULER_POLL_SECONDS=60

# Optional integrations
SUMUP_API_KEY=
SUMUP_WEBHOOK_SECRET=
EVENT_SETTINGS_ENCRYPTION_KEY=

# Optional printer emulator routing (for virtual printers)
PRINTER_EMULATOR_HOST=printer-emulator
PRINTER_EMULATOR_START_PORT=19100
# ESC/POS code page for western European accents on physical printers
PRINTER_CHARACTER_SET=PC858_EURO

# Optional Oracle reverse SSH tunnel sidecar (enable compose profile `oracle-tunnel`)
ORACLE_TUNNEL_HOST=
ORACLE_TUNNEL_USER=oracle-menu-tunnel
ORACLE_TUNNEL_SSH_DIR_HOST=/opt/fantafestando/.secrets/oracle-menu-tunnel
ORACLE_TUNNEL_KEY_FILENAME=id_ed25519
ORACLE_TUNNEL_REMOTE_BIND_ADDRESS=127.0.0.1
ORACLE_TUNNEL_REMOTE_PORT=3302
ORACLE_TUNNEL_LOCAL_HOST=fantafestando-menu
ORACLE_TUNNEL_LOCAL_PORT=3000
ORACLE_TUNNEL_SERVER_ALIVE_INTERVAL=30
ORACLE_TUNNEL_SERVER_ALIVE_COUNT_MAX=3
ORACLE_TUNNEL_STRICT_HOST_KEY_CHECKING=accept-new
