# MongoDB bootstrap credentials (used by mongo container)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-strong-password
MONGO_DATABASE=fantafestando

# App runtime
MONGODB_URI=mongodb://root:change-me-strong-password@mongo:27017/fantafestando?authSource=admin
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://backoffice-fantafestando.ddns.net
NEXTAUTH_URL_MENU=https://fantafestando.ddns.net
NEXTAUTH_URL_INTERNAL=http://fantafestando-backoffice:3000
APP_VERSION=0.2.0
APP_BUILD=
APP_BUILD_DATE=
APP_RUNTIME_ENV_FILE=.env.production
APP_IMAGE_NAME=fantafestando-app
APP_IMAGE_TAG=latest
BACKOFFICE_BIND_PORT=3101
MENU_BIND_PORT=3102

# Optional integrations
SUMUP_API_KEY=
SUMUP_WEBHOOK_SECRET=
EVENT_SETTINGS_ENCRYPTION_KEY=

# Optional printer emulator routing (for virtual printers)
PRINTER_EMULATOR_HOST=printer-emulator
PRINTER_EMULATOR_START_PORT=19100
