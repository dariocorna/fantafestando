[Unit]
Description=FantaFestando menu reverse SSH tunnel to Oracle
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
EnvironmentFile=/etc/fantafestando/oracle-menu-reverse-tunnel.env
ExecStart=/usr/bin/env bash /opt/fantafestando/scripts/oracle-menu-reverse-tunnel.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
